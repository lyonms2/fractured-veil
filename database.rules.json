// REGRAS DO REALTIME DATABASE
//
// Nota de formato: aqui os comentários são // de linha. Uma chave "//"
// dentro do JSON não é comentário nenhum — o Firebase lê-a como um
// CAMINHO chamado //, e no topo rejeita tudo o que não seja "rules".
//
// Havia aqui mais três blocos: arena, roubaMonte e batalhaNaval, os jogos
// PvP. Saíram porque os jogos já não existem, e enquanto existiram as
// regras eram largas demais — ".write": "auth != null" no nível da
// coleção deixava qualquer jogador autenticado escrever a pontuação de
// qualquer outro, mexer numa sala a meio de um jogo alheio, e escrever
// nas notificações de prémios de terceiros.
//
// O que fica segue uma regra só: quem escreve é o dono, e o valor é
// verificado. É a diferença entre "está autenticado" e "é ele".

{
  "rules": {

    "presence": {
      "$uid": {
        ".read":  "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },

    "snakeRanking": {
      "$tier": {
        ".read": "auth != null",
        ".indexOn": ["score"],

        // A escrita já era por dono — era a única regra bem feita do
        // ficheiro antigo. Faltava olhar para o VALOR: aceitava 999999.
        //
        // O inteiro verifica-se com % 1 === 0. A primeira versão usava
        // toFixed(0), que existe em JavaScript e NÃO existe aqui: a
        // linguagem destas regras é bem mais pequena. O emulador recusou
        // o ficheiro com "No such method/property 'toFixed'".
        // A maior pontuação possível é 30, no tier 3 (js/snake.js:258),
        // portanto 100 dá folga de sobra e continua longe do absurdo.
        "$uid": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.hasChildren(['score'])",

          "score": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100 && newData.val() % 1 === 0"
          },
          "nome":   { ".validate": "newData.isString() && newData.val().length <= 40" },
          "wallet": { ".validate": "newData.isString() && newData.val() === $uid" },
          "ts":     { ".validate": "newData.isNumber()" },

          // Qualquer campo fora dos quatro acima é recusado.
          "$outro": { ".validate": false }
        }
      }
    }

  }
}
