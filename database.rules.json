// REGRAS DO REALTIME DATABASE
//
// Nota de formato: aqui os comentários são // de linha. Uma chave "//"
// dentro do JSON não é comentário nenhum — o Firebase lê-a como um
// CAMINHO chamado //, e no topo rejeita tudo o que não seja "rules".
//
// Havia aqui mais três blocos: arena, roubaMonte e batalhaNaval, os jogos
// PvP. Saíram porque os jogos já não existem, e enquanto existiram as
// regras eram largas demais — ".write": "auth != null" no nível da
// coleção deixava qualquer jogador autenticado escrever a pontuação de
// qualquer outro, mexer numa sala a meio de um jogo alheio, e escrever
// nas notificações de prémios de terceiros.
//
// O que fica segue uma regra só: quem escreve é o dono, e o valor é
// verificado. É a diferença entre "está autenticado" e "é ele".

{
  "rules": {

    "presence": {
      "$uid": {
        ".read":  "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },

    "snakeRanking": {
      "$tier": {
        ".read": "auth != null",
        ".indexOn": ["score"],

        // A escrita já era por dono — era a única regra bem feita do
        // ficheiro antigo. Faltava olhar para o VALOR: aceitava 999999.
        //
        // O inteiro verifica-se com % 1 === 0. A primeira versão usava
        // toFixed(0), que existe em JavaScript e NÃO existe aqui: a
        // linguagem destas regras é bem mais pequena. O emulador recusou
        // o ficheiro com "No such method/property 'toFixed'".
        // A maior pontuação possível é 30, no tier 3 (js/snake.js:258),
        // portanto 100 dá folga de sobra e continua longe do absurdo.
        "$uid": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.hasChildren(['score'])",

          "score": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100 && newData.val() % 1 === 0"
          },
          "nome":   { ".validate": "newData.isString() && newData.val().length <= 40" },
          "wallet": { ".validate": "newData.isString() && newData.val() === $uid" },
          "ts":     { ".validate": "newData.isNumber()" },
          // O retrato do avatar, para a lista desenhá-lo: semente,
          // raridade, fase e DNA — uns 150 bytes.
          "av":     { ".validate": "newData.hasChildren(['seed', 'dna']) && newData.child('seed').isNumber()" },

          // Qualquer campo fora dos quatro acima é recusado.
          "$outro": { ".validate": false }
        }
      }
    },

    // O RANKING DA FUSÃO DE ESFERAS (js/fusao.js), no mesmo molde do
    // Snake. Faltava inteiro: sem regra, o banco nega tudo por omissão,
    // e o ranking da Fusão respondia sempre "não foi possível carregar".
    //
    // A pontuação é bem maior que a do Snake — uma partida boa passa dos
    // 5000 —, então o teto é outro. Um milhão fica muito acima de
    // qualquer partida real e continua a barrar o valor absurdo.
    "fusaoRanking": {
      "$tier": {
        ".read": "auth != null",
        ".indexOn": ["score"],
        "$uid": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.hasChildren(['score'])",
          "score": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000 && newData.val() % 1 === 0"
          },
          "nome":   { ".validate": "newData.isString() && newData.val().length <= 40" },
          "wallet": { ".validate": "newData.isString() && newData.val() === $uid" },
          "ts":     { ".validate": "newData.isNumber()" },
          // O retrato do avatar, para a lista desenhá-lo: semente,
          // raridade, fase e DNA — uns 150 bytes.
          "av":     { ".validate": "newData.hasChildren(['seed', 'dna']) && newData.child('seed').isNumber()" },
          "$outro": { ".validate": false }
        }
      }
    },

    // O RANKING DO TETRA ELEMENTAL (js/tetra.js), no mesmo molde. A
    // pontuação cresce com o nível e uma partida longa passa das dezenas
    // de milhares; cinco milhões fica longe de qualquer partida real.
    "tetraRanking": {
      "$tier": {
        ".read": "auth != null",
        ".indexOn": ["score"],
        "$uid": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.hasChildren(['score'])",
          "score": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 5000000 && newData.val() % 1 === 0"
          },
          "nome":   { ".validate": "newData.isString() && newData.val().length <= 40" },
          "wallet": { ".validate": "newData.isString() && newData.val() === $uid" },
          "ts":     { ".validate": "newData.isNumber()" },
          "av":     { ".validate": "newData.hasChildren(['seed', 'dna']) && newData.child('seed').isNumber()" },
          "$outro": { ".validate": false }
        }
      }
    },

    // ── O PVP (api/pvp.js) ──
    //
    // Quem decide é o servidor, que escreve pelo Admin SDK e não passa por
    // estas regras. O cliente só pode:
    //   · marcar a própria presença (pvp/online), que os amigos leem
    //   · ler a própria entrada na fila e APAGÁ-LA (o onDisconnect e o
    //     "cancelar" tiram-no de lá; entrar, só pelo servidor, que mede o
    //     poder da equipe no banco e não no pedido)
    //   · ler o ponteiro da própria sala
    //   · ler e apagar um convite de que é parte (recusar, cancelar)
    //   · ler a sala em que joga, e marcar lá a própria presença
    "pvp": {
      "online": {
        ".read": "auth != null",
        "$uid": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.hasChildren(['ts', 'estado'])",
          "ts":     { ".validate": "newData.isNumber() && newData.val() <= now + 60000" },
          "estado": { ".validate": "newData.isString() && newData.val().matches(/^(livre|fila|sala)$/)" },
          "$outro": { ".validate": false }
        }
      },
      "fila": {
        "$uid": {
          ".read":  "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid && !newData.exists()"
        }
      },
      "jogador": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid"
        }
      },
      "convites": {
        "$para": {
          ".read": "auth != null && auth.uid === $para",
          "$de": {
            ".read":  "auth != null && auth.uid === $de",
            ".write": "auth != null && (auth.uid === $para || auth.uid === $de) && !newData.exists()"
          }
        }
      },
      "salas": {
        "$sala": {
          ".read": "auth != null && data.child('jogadores').child(auth.uid).exists()",
          "presenca": {
            "$uid": {
              ".write": "auth != null && auth.uid === $uid && root.child('pvp').child('salas').child($sala).child('jogadores').child($uid).exists()",
              ".validate": "newData.isNumber() && newData.val() <= now + 60000"
            }
          }
        }
      }
    }

  }
}
