rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Players ──
    // Leitura por qualquer autenticado (marketplace precisa de ver dados do vendedor)
    // Escrita só no próprio doc — transferências financeiras passam pela API (Admin SDK)
    match /players/{uid} {
      allow read:  if request.auth != null;
      allow write: if request.auth.uid == uid;
    }

    // ── Marketplace de avatares ──
    match /avatarMarket/{listingId} {
      allow read:   if request.auth != null;
      allow create: if request.auth != null
                 && request.resource.data.sellerId == request.auth.uid;
      allow delete: if request.auth != null
                 && resource.data.sellerId == request.auth.uid;
      allow update: if false;
    }

    // ── Marketplace de ovos ──
    match /eggMarket/{listingId} {
      allow read:   if request.auth != null;
      allow create: if request.auth != null
                 && request.resource.data.sellerId == request.auth.uid;
      allow delete: if request.auth != null
                 && resource.data.sellerId == request.auth.uid;
      allow update: if false;
    }

    // ── Missões ──
    match /missoes/{missId} {
      allow read: if request.auth != null;

      // Criar: chamador deve ser employer, status inicial = 'open', reward inteiro e positivo
      allow create: if request.auth != null
        && request.resource.data.employer == request.auth.uid
        && request.resource.data.status   == 'open'
        && request.resource.data.reward   is int
        && request.resource.data.reward   >  0;

      // Update: transições de status validadas por papel
      allow update: if request.auth != null && (
        // Employer cancela missão aberta
        (resource.data.employer         == request.auth.uid
          && resource.data.status         == 'open'
          && request.resource.data.status == 'cancelled')
        ||
        // Employer selecciona worker (open → awaiting)
        (resource.data.employer         == request.auth.uid
          && resource.data.status         == 'open'
          && request.resource.data.status == 'awaiting')
        ||
        // Employer reverte seleção (awaiting → open)
        (resource.data.employer         == request.auth.uid
          && resource.data.status         == 'awaiting'
          && request.resource.data.status == 'open')
        ||
        // Worker confirma seleção (awaiting → progress)
        (resource.data.selectedWorker   == request.auth.uid
          && resource.data.status         == 'awaiting'
          && request.resource.data.status == 'progress')
        ||
        // Worker gera/actualiza QR de entrega (mantém progress)
        (resource.data.selectedWorker   == request.auth.uid
          && resource.data.status         == 'progress'
          && request.resource.data.status == 'progress')
        ||
        // Employer ou worker abre disputa (progress → dispute)
        ((resource.data.employer        == request.auth.uid
            || resource.data.selectedWorker == request.auth.uid)
          && resource.data.status         == 'progress'
          && request.resource.data.status == 'dispute')
        ||
        // Actualizar contadores de votos dentro de disputa activa
        (resource.data.status           == 'dispute'
          && request.resource.data.status == 'dispute')
      );

      // Clientes não podem apagar missões
      allow delete: if false;

      // ── Candidaturas ──
      match /candidaturas/{candidatoId} {
        allow read: if request.auth != null;
        // Só o próprio pode criar a sua candidatura
        allow create: if request.auth.uid == candidatoId
          && request.resource.data.status == 'pending';
        // Employer aceita/rejeita; candidato pode actualizar a sua
        allow update: if request.auth != null
          && (get(/databases/$(database)/documents/missoes/$(missId)).data.employer == request.auth.uid
              || request.auth.uid == candidatoId);
        allow delete: if false;
      }

      // ── Votos ──
      match /votos/{voterId} {
        allow read: if request.auth != null;
        // Cada votante cria apenas o seu próprio doc, uma única vez
        allow create: if request.auth.uid == voterId
          && !exists(/databases/$(database)/documents/missoes/$(missId)/votos/$(voterId))
          && request.resource.data.voter == request.auth.uid;
        // Votos são imutáveis e não apagáveis
        allow update, delete: if false;
      }
    }

    // ── Config (pool P2E, etc.) — read-only para clientes, escrita via Admin SDK ──
    match /config/{doc} {
      allow read:  if request.auth != null;
      allow write: if false;
    }
    match /config/{doc}/{sub=**} {
      allow read:  if request.auth != null;
      allow write: if false;
    }
  }
}
