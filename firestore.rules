rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ══════════════════════════════════════════════════════════════
    //  PLAYERS
    //
    //  A regra era "allow write: if request.auth.uid == uid" — o dono
    //  escrevia o que quisesse no próprio documento, sem validação de
    //  campos. Isso era um caminho direto para MATIC real, porque o
    //  api/resgatar.js lê DESTE documento tudo o que decide um saque:
    //
    //    gs.cristais     o saldo que o autoriza
    //    ultimoResgate   a espera de 30 segundos
    //    resgateLog      o teto de 50 gemas por dia
    //
    //  As três travas ficavam no lugar que o atacante controlava, e por
    //  isso caíam juntas: escrever gs.cristais e apagar o resgateLog dava
    //  um saque sem limite.
    //
    //  Agora esses campos são do SERVIDOR. O Admin SDK não passa pelas
    //  regras, então os endpoints continuam gravando; o cliente não. O
    //  js/firebase.js deixou de enviá-los (ver _gsSemDinheiro) — e isto
    //  aqui é o que obriga, porque o console está aberto a qualquer um e
    //  código educado não é segurança.
    //
    //  AS MOEDAS FICAM DE FORA, e é uma decisão, não um esquecimento: o
    //  earnCoins() as credita no cliente em doze lugares (minijogos, PvE,
    //  visitas). Travá-las aqui parava o jogo. Continua possível forjar
    //  moedas, mas elas só compram itens da loja: o câmbio de moedas por
    //  cristais saiu do jogo. O cambioLog e o ultimoCambio, que eram dele,
    //  continuam fechados aqui embaixo — ninguém os grava, e um campo
    //  fechado não custa nada.
    //
    //  Mover as recompensas para o servidor é o passo seguinte, e é outro
    //  trabalho.
    // ══════════════════════════════════════════════════════════════

    // Campos de topo que só o servidor grava.
    function camposDoServidor() {
      return ['cristais', 'cristaisBonus', 'resgateLog', 'ultimoResgate',
              'cambioLog', 'ultimoCambio',
              // Estava aqui 'referralBonus', que NÃO é campo do jogador:
              // só existe no registro do resgate (subcoleção) e na resposta
              // da API. Protegia um fantasma e deixava de fora os dois
              // reais — o referralEarned, que a página de indicações
              // mostra como "total ganho", e o referralCount. Sem eles,
              // qualquer um inflava o próprio número de ganhos.
              'referralChain', 'referralEarned', 'referralCount',
              // A carteira de MATIC da conta. Quem a gravava era o cliente,
              // sem prova de posse, e o api/processar-compra.js dá a compra
              // à conta cuja carteira é a do evento — gravar a carteira de
              // outra pessoa era receber as compras dela. Agora só o
              // servidor a grava, depois de conferir uma assinatura
              // (vincular-carteira, em api/resgatar.js).
              'carteira',
              // O registro dos ovos que o servidor emitiu. É a prova que
              // deixa vender um ovo posto pelo próprio avatar sem confiar
              // no avatarSlots, que o cliente grava. Ver handleBotarOvo
              // e handleListarOvo em api/pool.js.
              'ovosEmitidos',
              // O registro dos avatares que o servidor emitiu. É a prova
              // que o api/comprar-avatar.js exige para deixar listar, em
              // vez de acreditar no avatarSlots que o cliente grava.
              'avataresEmitidos',
              /* AS CERTIDÕES. É aqui que fica o DNA de cada avatar — o
                 corpo, a índole, a cor, a tendência, o vigor — e é isso
                 que dá valor a um avatar desde que existe herança.

                 Ficavam DENTRO do avatarSlots, que o cliente grava por
                 inteiro: quem abrisse o console dava a si mesmo os genes
                 que quisesse. Mudaram de lugar por causa do que estas
                 regras conseguem expressar — o avatarSlots é um array e
                 as regras não sabem percorrer arrays, então não há como
                 escrever "o cliente não mexe no nascimento de nenhum
                 slot". Um campo de topo se protege em uma linha, e é
                 esta.

                 Quem as grava é o handleInvocar do api/pool.js, e também
                 o chocar e o cruzar. */
              'certidoes',
              /* Quantas invocações grátis o jogador já gastou. São três
                 na vida, e depois os avatares são comprados na loja.

                 Ficava no gs.totalInvocacoes, dentro do documento que o
                 cliente grava por inteiro: zerar o número e invocar de
                 novo era uma linha no console. */
              'invocacoesUsadas',
              /* OS OVOS. Um ovo É o DNA do filho que está lá dentro, e
                 esse DNA vale o mesmo que o de um avatar — e um avatar
                 é vendido por cristais, que saem em MATIC.

                 Ficavam dentro do avatarSlots, em slot.eggs, e podiam ser
                 escritos no console de três maneiras: os genes à mão, o
                 seed da cruza sorteado até sair o filho desejado, ou um
                 ovo inteiro do nada, sem ter cruzado coisa nenhuma.

                 Mudaram de lugar pela razão de sempre: as regras não
                 sabem percorrer arrays, e um campo de topo se protege em
                 uma linha. O slot.eggs continua existindo e o cliente
                 continua gravando, mas só para dizer ONDE está cada ovo
                 — o que o ovo É vem daqui.

                 Quem os grava é o handleCruzar do api/pool.js, e quem os
                 apaga é o handleChocarOvo. */
              'ovos',
              /* A CADEIA DE DONOS. Por quantas mãos cada avatar passou,
                 por quanto foi vendido de cada vez e em que nível estava.

                 É o histórico de preços que o comprador vê antes de
                 decidir quanto pagar (js/historico.js) — e ficava dentro
                 do avatarSlots, que o VENDEDOR grava por inteiro.
                 Inventar três vendas anteriores a 5000 cristais cada era
                 uma linha no console, e quem pagava por essa linha era o
                 próximo comprador.

                 Gravada só pelo api/comprar-avatar.js, dentro da
                 transação que move os cristais: o preço registrado é, por
                 construção, o que foi mesmo pago. */
              'donos',
              /* OS QUE MORRERAM. O `dead` fica dentro do avatarSlots:
                 pôr `false` num avatar morto devolvia a vida a ele, e com
                 ela o direito de lutar, de cruzar e de ser vendido.

                 Aqui a morte, uma vez conhecida, não se desfaz — o
                 applyGameState força o `dead` a partir deste mapa, e a
                 listagem no mercado recusa quem estiver nele.

                 DITO COM TODAS AS LETRAS: isto estreita a porta, não a
                 fecha. Quem avisa da morte é o próprio jogo (handleMorreu,
                 em api/pool.js), então quem modificar o jogo para nunca
                 avisar continua podendo ressuscitar o bicho. O que deixa
                 de funcionar é editar o documento, que estava ao alcance
                 de qualquer um. */
              'mortos',
              /* OS LAÇOS entre avatares, e a hora do último pedido.

                 Dão precisão na batalha e acompanham o avatar na venda,
                 portanto têm valor. Quem os grava é a acao 'laco' do
                 api/pool.js, com teto por dia e por par, os parentes no
                 chocar-ovo e a venda no api/comprar-avatar.js. */
              'lacos', 'ultimoLaco',
              /* O NÍVEL QUE O SERVIDOR RECONHECE (js/niveis.js).

                 O nível vive no avatarSlots, que o cliente grava por
                 inteiro: uma linha no console punha um bicho novo no
                 nível 60. No PvE isso é enganar-se a si mesmo; no PvP,
                 onde o nível decide a luta, é o fim do jogo competitivo.

                 Aqui fica um segundo número, que só o servidor escreve e
                 que só sobe degrau a degrau, no ritmo de quem joga (a
                 acao 'nivel' do api/pool.js). É dele que o PvP monta as
                 equipas; o do slot continua a ser o que o jogador vê.

                 Como o `mortos`, isto estreita a porta e não a fecha:
                 quem avisa que subiu continua a ser o jogo, que corre no
                 navegador. O que deixa de funcionar é o salto. */
              'niveis',
              /* OS PONTOS DA TEMPORADA (js/pvp-rank.js).

                 É a classificação do PvP, e é a única coisa que se leva
                 de uma luta que não se pode ganhar de outra maneira.
                 Se o cliente a pudesse escrever, escrevia o primeiro
                 lugar — e uma tabela que se escreve sozinha não é uma
                 tabela.

                 Quem a escreve é o fim da luta (api/pvp.js), que já é
                 conferido pelo servidor: ele refaz a partida inteira a
                 partir da semente e da lista de jogadas antes de dizer
                 quem ganhou. */
              'rank',
              /* QUANTAS VEZES CADA PAR JÁ SE ENFRENTOU HOJE. É o que
                 limita a três por dia os pontos entre as mesmas duas
                 pessoas (js/pvp-rank.js) — sem isto, dois combinados
                 subiam a tabela um ao outro. Quem conta é o fim da
                 luta, no servidor. */
              'rankPares',
              /* O SELO DA TEMPORADA e o que ele pagou (js/temporada.js).
                 É o direito ao prêmio: escrevê-lo seria entrar no bolo
                 sem pagar. Quem o grava é a acao 'selo' do api/pvp.js,
                 na mesma transação que debita os cristais. */
              'selos',
              /* E O QUE SE GANHOU em cada temporada fechada. É dinheiro
                 recebido: o cliente vê, e não escreve. */
              'premios',
              /* O CÓDIGO DE AMIGO — as seis letras que se passam a
                 alguém para ele nos adicionar.

                 É emitido pelo servidor e é ÚNICO: cada um tem o seu
                 documento na coleção `codigosAmigo`, criado numa
                 transação que falha se ele já existir. Se o cliente
                 pudesse gravá-lo, gravaria o do vizinho — e os pedidos
                 de amizade do vizinho passariam a chegar para ele. */
              'codigoAmigo'];
    }

    /* O inboxEggs é a PORTA DA VENDA de ovos: o handleListarOvo do
       api/pool.js só aceita listar ovos que estejam nele, e devolve
       OVO_NOT_FOUND para todo o resto. Escrever nele era fabricar ovos
       e vendê-los por cristais, que saem em MATIC.

       Mas o cliente precisa ESVAZIÁ-LO: o applyGameState() passa os ovos
       do inbox para o slot e depois o limpa. Se não pudesse limpar, os
       mesmos ovos seriam consumidos de novo a cada carregamento — o
       oposto do que se quer.

       Por isso: pode encolher, nunca crescer. Encher está fechado, limpar
       continua funcionando.

       O que isto NÃO pega, dito com todas as letras: trocar um ovo por
       outro no mesmo movimento mantém o tamanho e passa. Fechar isso
       exigiria comparar elemento a elemento, o que as regras não sabem
       fazer com mapas. Para fechar de vez, é preciso tirar o campo do
       documento do jogador e colocá-lo numa subcoleção que o cliente não
       grava — e aí esvaziar passa a ser um endpoint. */
    function inboxNaoCresce() {
      return !('inboxEggs' in request.resource.data)
          || !('inboxEggs' in resource.data)
             ? !('inboxEggs' in request.resource.data)
               || request.resource.data.inboxEggs.size() == 0
             : request.resource.data.inboxEggs.size()
                 <= resource.data.inboxEggs.size();
    }
    // Dentro do mapa gs. As moedas não entram — ver acima.
    function gsDoServidor() {
      // O cristaisBonus entra aqui pela mesma razão que o cristais: é
      // dinheiro do jogo. O bônus de compra saiu, então ninguém cria mais
      // bônus novo; só os débitos do servidor e a venda no mercado
      // (api/comprar-avatar.js) mexem nele — se o cliente pudesse
      // escrevê-lo, o bônus deixaria de ser bônus e viraria um campo de
      // texto onde cada um escreve quanto quer gastar.
      return ['cristais', 'cristaisBonus', 'extraSlots'];
    }

    function topoIntacto() {
      return !request.resource.data.diff(resource.data)
               .affectedKeys().hasAny(camposDoServidor());
    }

    // Três casos, em ordem:
    //   a escrita não traz gs           → nada a comparar
    //   traz gs e o documento já o tem  → nenhum campo do servidor mudou
    //   traz gs e o documento não tem   → não pode trazer campos do servidor
    //
    // O set(..., {merge:true}) do js/firebase.js funde mapas aninhados em
    // vez de substituí-los, então um campo omitido chega aqui com o valor
    // que já estava lá e o diff não o vê mudar. É disso que depende esta
    // regra deixar o jogo salvar normalmente.
    function gsIntacto() {
      return !('gs' in request.resource.data)
          || ('gs' in resource.data
                ? !request.resource.data.gs.diff(resource.data.gs)
                     .affectedKeys().hasAny(gsDoServidor())
                : !request.resource.data.gs.keys().hasAny(gsDoServidor()));
    }

    match /players/{uid} {
      /* LEITURA: SÓ O DONO, E QUEM O CONVIDOU.
         Era "qualquer autenticado": qualquer jogador lia o documento
         inteiro de qualquer outro — carteira, saldo, convites, certidões.

         O cliente só lê o próprio documento, e mais uma coisa: a página de
         Indicações lista os jogadores que ELE convidou (L1, L2 e L3), com
         três consultas where('referralChain.lN', '==', uid). Por isso a
         leitura também vale quando o documento aponta para quem lê na
         cadeia de convites. O mercado não lê documentos de jogadores: o
         que o comprador vê vem do anúncio (avatarMarket), e os amigos
         passam pelo servidor (api/amigos.js). */
      allow read: if request.auth != null
                  && (request.auth.uid == uid
                      || resource.data.referralChain.l1 == request.auth.uid
                      || resource.data.referralChain.l2 == request.auth.uid
                      || resource.data.referralChain.l3 == request.auth.uid);

      // Um documento novo não pode nascer com saldo. Os campos ausentes
      // viram 0 do lado do servidor, que é o correto.
      allow create: if request.auth.uid == uid
                 && !request.resource.data.keys().hasAny(camposDoServidor())
                 && (!('gs' in request.resource.data)
                     || !request.resource.data.gs.keys().hasAny(gsDoServidor()))
                 && (!('inboxEggs' in request.resource.data)
                     || request.resource.data.inboxEggs.size() == 0);

      allow update: if request.auth.uid == uid
                 && topoIntacto()
                 && gsIntacto()
                 && inboxNaoCresce();

      // Sem isto, apagar e recriar o documento era um botão de reset — e,
      // com o create acima, também uma forma de limpar um resgateLog.
      allow delete: if false;
    }

    /* ── OS MERCADOS SÃO SÓ DE LEITURA PARA O CLIENTE ──
       Antes deixavam criar e apagar listagens desde que o sellerId fosse
       o próprio. Isso contornava as APIs por inteiro: escrever à mão um
       documento com raridade 'Lendário' punha um avatar inventado à
       venda, sem passar pela validação do api/comprar-avatar.js nem pelo
       avataresEmitidos, e sem pagar a taxa de listagem. O comprador
       pagava cristais de verdade por ele.
       Apagar tinha o seu próprio problema: o vendedor podia tirar a
       listagem no instante em que alguém a comprava.
       O cliente nunca precisou disso — lista e tira da lista sempre pela
       API (js/avatars-market.js). O Admin SDK não passa pelas regras,
       então os endpoints continuam gravando. */
    /* ── AS TEMPORADAS ──

       O bolo do mês, quem comprou selo e, depois do fecho, a lista de
       quem recebeu o quê. Toda a gente lê — é o prêmio anunciado, e um
       prêmio que não se pode conferir não vale nada — e ninguém
       escreve: quem escreve é o servidor (api/pvp.js), que cobra o selo
       e fecha o mês. */
    match /temporadas/{temporada} {
      allow read:  if request.auth != null;
      allow write: if false;
    }
    match /temporadas/{temporada}/selos/{uid} {
      allow read:  if request.auth != null;
      allow write: if false;
    }

    match /avatarMarket/{listingId} {
      allow read: if request.auth != null;
      allow create, update, delete: if false;
    }

    /* ── OS CÓDIGOS DE AMIGO ──

       Um documento por código, com o uid de quem o tem. É o que garante
       que dois jogadores não fiquem com o mesmo: a criação roda numa
       transação que falha se o documento já existir (ver _codigoDe, em
       api/amigos.js).

       FECHADA DOS DOIS LADOS, e a leitura é a que importa: esta coleção
       é o índice inverso código → jogador, e quem pudesse lê-la a
       percorreria e ficaria com o código de todo mundo. Quem traduz um
       código é o servidor, e só quando alguém o informa. */
    match /codigosAmigo/{codigo} {
      allow read, write: if false;
    }

    /* ── AS CARTEIRAS VINCULADAS ──

       Um documento por endereço, com o uid da conta a que ele pertence.
       É o que impede a mesma carteira de ficar vinculada a duas contas:
       o vincular-carteira (api/resgatar.js) roda numa transação que recusa
       um endereço já preso a outro uid.

       FECHADA DOS DOIS LADOS. Sem regra nenhuma ela já seria fechada,
       mas fica escrito aqui para que ninguém a abra por engano: quem
       pudesse gravar nela prenderia a carteira de outra pessoa na
       própria conta. */
    match /carteiras/{endereco} {
      allow read, write: if false;
    }

    // ── Config (pool P2E etc.) — só leitura para o cliente, gravação via Admin SDK ──
    match /config/{doc} {
      allow read:  if request.auth != null;
      allow write: if false;
    }
    match /config/{doc}/{sub=**} {
      allow read:  if request.auth != null;
      allow write: if false;
    }
  }
}
