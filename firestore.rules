rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ══════════════════════════════════════════════════════════════
    //  PLAYERS
    //
    //  A regra era "allow write: if request.auth.uid == uid" — o dono
    //  escrevia o que quisesse no próprio documento, sem validação de
    //  campos. Isso era um caminho direto para MATIC real, porque o
    //  api/resgatar.js lê DESTE documento tudo o que decide um saque:
    //
    //    linha 248   gs.cristais     o saldo que o autoriza
    //    linha 255   ultimoResgate   a espera de 30 segundos
    //    linha 263   resgateLog      o tecto de 50 gemas por dia
    //
    //  As três travas viviam no sítio que o atacante controlava, portanto
    //  caíam juntas: escrever gs.cristais e apagar o resgateLog dava um
    //  saque sem limite. O mesmo valia para o cambioLog, de onde o
    //  api/cambiar.js tira o tecto diário do câmbio.
    //
    //  Agora esses campos são do SERVIDOR. O Admin SDK não passa por
    //  regras, portanto os endpoints continuam a escrevê-los; o cliente
    //  não. O js/firebase.js deixou de os enviar (ver _gsSemDinheiro) —
    //  e isto aqui é o que o obriga, porque o console está aberto a
    //  qualquer um e código educado não é segurança.
    //
    //  AS MOEDAS FICAM DE FORA, e é uma decisão, não um esquecimento: o
    //  earnCoins() credita-as no cliente em doze sítios (minijogos, PvE,
    //  ovos). Travá-las aqui parava o jogo. Fica em aberto forjar moedas
    //  e trocá-las por cristais — mas o câmbio exige nível 20 e tem tecto
    //  diário por raridade (1/2/4), que agora vive num cambioLog que o
    //  cliente já não escreve, mais o tecto global de 100 da pool. De
    //  dreno sem limite passa a fio de 4 cristais por dia.
    //
    //  Mover as recompensas para o servidor é o passo seguinte, e é outro
    //  trabalho.
    // ══════════════════════════════════════════════════════════════

    // Campos de topo que só o servidor escreve.
    function camposDoServidor() {
      return ['cristais', 'cristaisBonus', 'resgateLog', 'ultimoResgate',
              'cambioLog', 'ultimoCambio',
              // Estava aqui 'referralBonus', que NÃO é campo do jogador:
              // só existe no registo do resgate (subcoleção) e na resposta
              // da API. Protegia um fantasma e deixava de fora os dois
              // reais — o referralEarned, que a página de indicações
              // mostra como "total ganho", e o referralCount. Sem eles,
              // qualquer um inflava o próprio número de ganhos.
              'referralChain', 'referralEarned', 'referralCount',
              // O registo dos ovos que o servidor emitiu. É a prova que
              // deixa vender um ovo posto pelo próprio avatar sem confiar
              // no avatarSlots, que o cliente escreve. Ver handleBotarOvo
              // e handleListarOvo em api/pool.js.
              'ovosEmitidos',
              // O registo dos avatares que o servidor emitiu, com a
              // raridade do ovo que cada um consumiu. É a prova que o
              // api/comprar-avatar.js exige para deixar listar, em vez
              // de acreditar no avatarSlots que o cliente escreve.
              'avataresEmitidos'];
    }

    /* O inboxEggs é a PORTA DA VENDA de ovos: o handleListarOvo do
       api/pool.js só aceita listar ovos que lá estejam, e devolve
       OVO_NOT_FOUND para tudo o resto. Escrever nele era fabricar ovos
       Lendários e vendê-los por cristais, que saem em MATIC.

       Mas o cliente precisa de o ESVAZIAR: o applyGameState() passa os
       ovos do inbox para o slot e depois limpa-o. Se não pudesse limpar,
       os mesmos ovos voltavam a ser consumidos em cada carregamento — o
       oposto do que se quer.

       Por isso: pode encolher, nunca crescer. Encher está fechado, limpar
       continua a funcionar.

       O que isto NÃO apanha, dito com todas as letras: trocar um ovo por
       outro no mesmo movimento mantém o tamanho e passa. Fechar isso
       exigia comparar elemento a elemento, que as regras não sabem fazer
       com mapas. Quem quiser fechá-lo de vez tem de tirar o campo do
       documento do jogador e pô-lo numa subcoleção que o cliente não
       escreve — e aí o esvaziar passa a ser um endpoint. */
    function inboxNaoCresce() {
      return !('inboxEggs' in request.resource.data)
          || !('inboxEggs' in resource.data)
             ? !('inboxEggs' in request.resource.data)
               || request.resource.data.inboxEggs.size() == 0
             : request.resource.data.inboxEggs.size()
                 <= resource.data.inboxEggs.size();
    }
    // Dentro do mapa gs. As moedas não entram — ver acima.
    function gsDoServidor() {
      // O cristaisBonus entra aqui pela mesma razão que o cristais: é
      // dinheiro do jogo. Só o api/processar-compra.js o credita e só
      // os débitos do servidor lhe mexem — se o cliente o pudesse
      // escrever, o bónus deixava de ser um bónus e passava a ser um
      // campo de texto onde cada um escreve o que quer gastar.
      return ['cristais', 'cristaisBonus', 'extraSlots'];
    }

    function topoIntacto() {
      return !request.resource.data.diff(resource.data)
               .affectedKeys().hasAny(camposDoServidor());
    }

    // Três casos, por ordem:
    //   a escrita não traz gs           → nada que comparar
    //   traz gs e o documento já o tem  → nenhum campo do servidor mudou
    //   traz gs e o documento não tem   → não pode trazer campos do servidor
    //
    // O set(..., {merge:true}) do js/firebase.js funde mapas encaixados em
    // vez de os substituir, portanto um campo omitido chega aqui com o
    // valor que já lá estava e o diff não o vê mudar. É disso que depende
    // esta regra deixar o jogo gravar normalmente.
    function gsIntacto() {
      return !('gs' in request.resource.data)
          || ('gs' in resource.data
                ? !request.resource.data.gs.diff(resource.data.gs)
                     .affectedKeys().hasAny(gsDoServidor())
                : !request.resource.data.gs.keys().hasAny(gsDoServidor()));
    }

    match /players/{uid} {
      // Leitura por qualquer autenticado — o marketplace precisa de ver
      // dados do vendedor. Vaza carteira e inventário de toda a gente, o
      // que é problema de privacidade e fica para outra passagem.
      allow read: if request.auth != null;

      // Um documento novo não pode nascer com saldo. Os campos ausentes
      // resolvem-se para 0 do lado do servidor, que é o correto.
      allow create: if request.auth.uid == uid
                 && !request.resource.data.keys().hasAny(camposDoServidor())
                 && (!('gs' in request.resource.data)
                     || !request.resource.data.gs.keys().hasAny(gsDoServidor()))
                 && (!('inboxEggs' in request.resource.data)
                     || request.resource.data.inboxEggs.size() == 0);

      allow update: if request.auth.uid == uid
                 && topoIntacto()
                 && gsIntacto()
                 && inboxNaoCresce();

      // Sem isto, apagar e recriar o documento era um botão de reset — e
      // com o create acima, também uma forma de limpar um resgateLog.
      allow delete: if false;
    }

    // ── Marketplace de avatares ──
    /* ── OS MERCADOS SÃO SÓ DE LEITURA PARA O CLIENTE ──
       Deixavam criar e apagar listagens desde que o sellerId fosse o
       próprio. Isso contornava as APIs por inteiro: escrever à mão um
       documento com raridade 'Lendário' punha um avatar inventado à
       venda, sem passar pela validação do api/comprar-avatar.js nem pelo
       avataresEmitidos, e sem pagar a taxa de listagem. O comprador
       pagava cristais a sério por ele.
       O apagar tinha o seu próprio problema: o vendedor podia tirar a
       listagem no instante em que alguém a comprava.
       O cliente nunca precisou disto — lista e deslista sempre pela API
       (js/avatars-market.js:303 e :347, js/eggs-market.js). O Admin SDK
       não passa por regras, portanto os endpoints continuam a escrever. */
    match /avatarMarket/{listingId} {
      allow read: if request.auth != null;
      allow create, update, delete: if false;
    }

    // ── Config (pool P2E, etc.) — read-only para clientes, escrita via Admin SDK ──
    match /config/{doc} {
      allow read:  if request.auth != null;
      allow write: if false;
    }
    match /config/{doc}/{sub=**} {
      allow read:  if request.auth != null;
      allow write: if false;
    }
  }
}
