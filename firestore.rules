rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Players ──
    // Leitura por qualquer autenticado (marketplace precisa de ver dados do vendedor)
    // Escrita só no próprio doc — transferências financeiras passam pela API (Admin SDK)
    match /players/{uid} {
      allow read:  if request.auth != null;
      allow write: if request.auth.uid == uid;
    }

    // ── Marketplace de avatares ──
    match /avatarMarket/{listingId} {
      allow read:   if request.auth != null;
      allow create: if request.auth != null
                 && request.resource.data.sellerId == request.auth.uid;
      allow delete: if request.auth != null
                 && resource.data.sellerId == request.auth.uid;
      allow update: if false;
    }

    // ── Marketplace de ovos ──
    match /eggMarket/{listingId} {
      allow read:   if request.auth != null;
      allow create: if request.auth != null
                 && request.resource.data.sellerId == request.auth.uid;
      allow delete: if request.auth != null
                 && resource.data.sellerId == request.auth.uid;
      allow update: if false;
    }

    // ── Config (pool P2E, etc.) — read-only para clientes, escrita via Admin SDK ──
    match /config/{doc} {
      allow read:  if request.auth != null;
      allow write: if false;
    }
    match /config/{doc}/{sub=**} {
      allow read:  if request.auth != null;
      allow write: if false;
    }
  }
}
